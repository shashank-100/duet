{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "./src/worker/worker-configuration.d.ts"
    ]
  },
  "include": [
    "src/worker",
    "src/shared",
    "test"
  ]
}
